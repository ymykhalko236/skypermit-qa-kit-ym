  "unknowns": [
    {
      "id": "U-01",
      "question": "What does the system return when someone who isn't a reviewer (no X-Reviewer-Id) calls approve or reject? The text says these actions are reviewer-only but gives no status code or message.",
      "affects": [
        "EP-04",
        "EP-06"
      ]
    },
    {
      "id": "U-02",
      "question": "What does the system return when reject is called without a note? And does an empty or whitespace-only note count as given?",
      "affects": [
        "EP-07",
        "EP-08"
      ]
    },
    {
      "id": "U-03",
      "question": "SUBMITTED is transient and \"should never be observed\" (line 51). How can a test put a request in SUBMITTED to exercise cancel and the illegal actions from it, or should these cells be checked only by code review?",
      "affects": [
        "ST-08",
        "ST-09",
        "ST-10",
        "ST-11",
        "ST-12",
        "ST-13",
        "ST-14"
      ]
    },
    {
      "id": "U-04",
      "question": "\"gates pass\" and \"gates fail\" are automatic, not caller-invoked. The general rule makes them illegal from every state except SUBMITTED, but how is that observable or testable, and does the 409 apply to them at all?",
      "affects": [
        "ST-02",
        "ST-03",
        "ST-16",
        "ST-17",
        "ST-23",
        "ST-24",
        "ST-30",
        "ST-31",
        "ST-37",
