        "line": 56,
        "text": "Set **only** by the maintenance completion endpoint — never inferred from elapsed time."
      }
    },
    {
      "id": "EP-11",
      "parameter": "submit outcome",
      "class": "all gates pass: request ends in UNDER_REVIEW",
      "valid": true,
      "representative": "submit a DRAFT that meets every gate",
      "quote": {
        "line": 20,
        "text": "either `UNDER_REVIEW` (all gates passed) or `REJECTED` (a gate failed)."
      }
    },
    {
      "id": "EP-12",
      "parameter": "submit outcome",
      "class": "a gate fails: request ends in REJECTED with failing_gate and rejection_reason populated",
      "valid": false,
      "representative": "submit a DRAFT whose altitude exceeds the zone ceiling",
      "quote": {
        "line": 33,
        "text": "Same — `failing_gate`/`rejection_reason` populated"
      }
    },
    {
      "id": "EP-13",
      "parameter": "submit outcome",
      "class": "state seen by the caller after submit is never SUBMITTED",
      "valid": true,
      "representative": "GET the request right after submit: state is UNDER_REVIEW or REJECTED",
      "quote": {
        "line": 31,
        "text": "Gates run synchronously; caller never observes `SUBMITTED` at rest"
      }
    },
    {
      "id": "EP-14",
      "parameter": "state of another overlapping request for the same aircraft",
      "class": "APPROVED or UNDER_REVIEW: counted by the overlap check",
      "valid": false,
      "representative": "an UNDER_REVIEW request for the same aircraft shares an instant with this window",
      "quote": {
        "line": 65,
        "text": "**Aircraft schedule overlap.** Only `APPROVED` and `UNDER_REVIEW` requests"
      }
    },
    {
      "id": "EP-15",
      "parameter": "state of another overlapping request for the same aircraft",
      "class": "DRAFT, REJECTED, CANCELLED or COMPLETED: invisible to the overlap check",
      "valid": true,
      "representative": "a CANCELLED request for the same aircraft shares an instant with this window",
      "quote": {
        "line": 67,
        "text": "gates. `DRAFT`, `REJECTED`, `CANCELLED` and `COMPLETED` are invisible to it"
      }
    },
    {
      "id": "EP-16",
      "parameter": "submit after a passed validate",
      "class": "another request for the same aircraft approved between validate and submit: submit fails",
      "valid": false,
      "representative": "validate passes, a conflicting request is approved, then submit",
      "quote": {
        "line": 68,
        "text": "which is why a request that passed `validate` can still fail at `submit`,"
      }
    }
  ],
